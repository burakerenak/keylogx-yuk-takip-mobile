<?xml version="1.0" encoding="utf-8"?>
<!--
    4.4 (11.10.2026): duz HTTP yalniz asagidaki adreslere acik.
    - 149.0.252.220: Keylogx TEST sunucusu (src/config.ts AKTIF_ORTAM = 'TEST' ile derlenen TEST paketi).
    - localhost / 10.0.2.2 / 10.0.3.2 / 127.0.0.1: gelistirme sirasinda Metro paketleyicisi (emulator).
    - keylogxapi.ebbedev.com.tr: API cagrilari HTTPS; yalniz eski kayitlarda "http://" ile saklanmis
      kanit fotografi adresleri acilmaya devam etsin diye (4.3.1 davranisi korunur).
    Canli sunucu (keylogxapi.ebbedev.com.tr) HTTPS oldugu icin etkilenmez; diger tum adreslerde duz HTTP kapali.
    Not: bu dosya varken manifest'teki android:usesCleartextTraffic dikkate alinmaz.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">149.0.252.220</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">keylogxapi.ebbedev.com.tr</domain>
    </domain-config>
</network-security-config>
